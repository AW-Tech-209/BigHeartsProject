# Imagen de DESARROLLO del frontend (@academia/web) con hot-reload (Vite).
# No apta para producción: sirve el dev server de Vite, no un build estático.
#
# El contexto de build es la RAÍZ del monorepo (ver docker-compose.yml), porque
# la web depende del workspace @academia/types y del package-lock.json de la raíz.

FROM node:22-alpine

WORKDIR /app

# Husky instala hooks de git en el `prepare`; dentro de la imagen no hay repo.
ENV HUSKY=0

# 1) Manifiestos primero, para aprovechar la caché de capas de npm.
COPY package.json package-lock.json ./
COPY packages/types/package.json ./packages/types/
COPY apps/web/package.json ./apps/web/
# apps/api sí participa del workspace: npm necesita su manifiesto para resolver
# el árbol completo, aunque esta imagen no lo use en runtime. Su postinstall
# corre `prisma generate`, que necesita el schema; por eso lo copiamos también
# (el cliente generado no lo usa la web, pero mantiene el `npm install` sano).
COPY apps/api/package.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma/

RUN npm install

# 2) El resto del código que la imagen necesita en build.
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/web ./apps/web

# El paquete de tipos se consume compilado (dist); la web lo importa así.
RUN npm run build:types

EXPOSE 5173

# --host expone el dev server fuera del contenedor (0.0.0.0) para que el
# navegador del host pueda alcanzarlo. docker-compose.yml puede sobrescribirlo.
CMD ["npm", "run", "dev", "--workspace", "@academia/web", "--", "--host", "0.0.0.0"]
