# Plantilla de variables de entorno de @academia/web.
# Copia este fichero a `.env` y rellena los valores:
#     cp apps/web/.env.example apps/web/.env
#
# El `.env` real está ignorado por git; este `.env.example` NO.

# OBLIGATORIA. URL base de @academia/api.
#
# Desarrollo: la API local (o el contenedor Docker), en el puerto 3000.
# Staging/producción (Vercel): la URL del backend en Render, p. ej.
#   https://bighearts-backend-staging.onrender.com
# En Vercel se define como variable de entorno del proyecto, NO en este fichero.
VITE_API_URL=http://localhost:3000

# OPCIONAL. Plazo en ms que espera el arranque a `/auth/refresh` antes de dar la
# sesión por ausente y volver usable la landing. Por defecto 3000.
# VITE_SESSION_REFRESH_TIMEOUT_MS=3000
