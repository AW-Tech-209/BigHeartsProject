// Schema de Prisma para @academia/api.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // NOTA: la extensión de Prisma para VS Code puede subrayar `url`/`directUrl`
  // como "deprecados, muévelos a prisma.config.ts". Es un aviso de Prisma 7; la
  // extensión va por delante de nuestra CLI. Estamos PINEADOS a Prisma 6 (ver
  // README → Trampas conocidas), donde declararlos aquí es lo correcto y
  // soportado: `prisma validate/generate/migrate` pasan sin error. Ignorable
  // hasta que haya una HU específica para migrar a Prisma 7.

  // Runtime: en dev, Postgres en Docker; en staging/prod, pooler de Supabase.
  url = env("DATABASE_URL")

  // Migraciones: conexión directa. En Supabase, pgbouncer no soporta las
  // sentencias que Prisma Migrate necesita, por eso se separa de `url`.
  // En el Postgres de Docker (sin pooler) ambas apuntan al mismo sitio.
  directUrl = env("DIRECT_URL")
}

/// Roles de usuario de la plataforma.
///
/// Los valores DEBEN coincidir con el enum `UserRole` de @academia/types, que
/// es el contrato compartido con el frontend. Prisma genera su propio enum a
/// partir de este; ambos comparten los mismos miembros a propósito.
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

/// Estado de la cuenta. Coincide con `UserStatus` de @academia/types.
///
/// `REJECTED` y `SUSPENDED` no son el mismo estado: el primero es una solicitud
/// de profesor denegada (la cuenta nunca estuvo activa), el segundo una cuenta
/// activa que un administrador deshabilitó. Se separan porque el login responde
/// un código de error distinto en cada caso y el usuario lee un mensaje que
/// tiene que ser cierto (decisión D13, `docs/ARQUITECTURA.md` §4.5).
enum UserStatus {
  ACTIVE
  PENDING
  REJECTED
  SUSPENDED
}

/// Nivel de hipoacusia. Coincide con `HearingLossLevel` de @academia/types.
enum HearingLossLevel {
  NONE
  MILD
  MODERATE
  SEVERE
  PROFOUND
}

/// Preferencia de comunicación. Coincide con `CommunicationPreference`.
enum CommunicationPreference {
  SIGN_LANGUAGE
  LIP_READING
  WRITTEN_TEXT
  SPOKEN_AUDIO
}

/// Nivel de inglés del aula. Coincide con `EnglishLevel` de @academia/types.
enum EnglishLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

/// Estado del aula. Coincide con `ClassroomStatus` de @academia/types.
///
/// En Fase 1 solo hay dos escritores: la creación la deja `PUBLISHED` (D15) y
/// HU-202 la pasa a `CANCELLED`. `DRAFT` está reservado para Fase 1.5 y
/// `COMPLETED` lo escribirá HU-404 al marcar asistencia (D16) — hasta entonces
/// "ya terminó" se DERIVA del tiempo, así que una consulta escrita contra
/// `status = COMPLETED` no devolvería nunca nada.
enum ClassroomStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

/// Estado de una reserva. Coincide con `BookingStatus` de @academia/types.
///
/// `ATTENDED` y `NO_SHOW` los fija el profesor al marcar asistencia (HU-404):
/// sin escritor hasta entonces, igual que `ClassroomStatus.COMPLETED`.
enum BookingStatus {
  CONFIRMED
  CANCELLED
  ATTENDED
  NO_SHOW
}

/// A qué plataforma apunta el enlace de la reunión. Coincide con
/// `MeetingProvider` de @academia/types.
///
/// Hasta HU-211 siempre valía `MANUAL` y no significaba nada. Desde HU-211 el
/// profesor lo declara: los subtítulos automáticos no funcionan igual en todas
/// las plataformas y el estudiante necesita saberlo. El enlace se sigue
/// pegando a mano en los tres casos — eso no cambia. `MANUAL` pasa a leerse
/// como "otra plataforma" (y es el valor honesto para las aulas de antes de
/// HU-211, que nunca dijeron cuál era la suya). `DAILY` sigue reservado y sin
/// escritor: gancho para cuando Fase 1.5 genere el enlace automáticamente.
enum MeetingProvider {
  MANUAL
  DAILY
  GOOGLE_MEET
  ZOOM
}

/// Usuario de la plataforma. Modelo base de la HU-001, ampliado en la HU de
/// registro con estado de cuenta y preferencias de accesibilidad.
model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  /// Hash de la contraseña. NUNCA se expone en las respuestas de la API
  /// (ver el tipo `User` de @academia/types, que no incluye este campo).
  password  String
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  role      UserRole   @default(STUDENT)
  status    UserStatus @default(ACTIVE)

  /// Preferencias de accesibilidad. Opcionales: `null` si no se declararon.
  hearingLossLevel        HearingLossLevel?        @map("hearing_loss_level")
  communicationPreference CommunicationPreference? @map("communication_preference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Sesiones (refresh tokens) emitidas para este usuario. Al borrar el usuario
  /// se borran en cascada.
  refreshTokens RefreshToken[]

  /// Aulas que imparte, si es profesor. Ver la nota de borrado en `Classroom`.
  classrooms Classroom[]

  /// Reservas hechas como estudiante. Ver la nota de borrado en `Booking`.
  bookings Booking[]

  @@map("users")
}

/// Refresh token OPACO de una sesión (HU-102).
///
/// El token que ve el cliente es una cadena aleatoria de alta entropía; aquí
/// solo se guarda su HASH (SHA-256), nunca el valor en claro: si se filtra la
/// BD, los tokens no son reutilizables. La búsqueda en login/refresh/logout se
/// hace por `tokenHash`.
///
/// Rotación: cada refresh revoca el token usado (`revokedAt`) y emite uno nuevo.
/// Si se vuelve a presentar un token ya revocado, se asume robo y se revoca toda
/// la familia de sesiones del usuario (detección de reuso).
model RefreshToken {
  id        String   @id @default(uuid()) @db.Uuid
  /// Hash SHA-256 del token en claro. Único: identifica la sesión.
  tokenHash String   @unique @map("token_hash")
  userId    String   @map("user_id") @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Cuándo caduca (ahora + REFRESH_TOKEN_TTL_DAYS al emitirlo).
  expiresAt DateTime @map("expires_at")
  /// Momento de revocación (logout, rotación o reuso detectado). `null` = activo.
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId])
  @@map("refresh_tokens")
}

/// Aula virtual: una clase con horario, cupo y sala de videollamada (HU-201).
///
/// La plataforma NO hace la videollamada. Lo que gestiona este modelo es quién
/// entra, cuándo y cuántos — y por eso las tres columnas delicadas son
/// `meetingLink`, `scheduledAt` y `currentBookings`.
model Classroom {
  id String @id @default(uuid()) @db.Uuid

  /// Dueño del aula. Solo él la edita o la cancela (HU-202), y solo él ve el
  /// enlace fuera de la ventana de acceso (§4.1).
  ///
  /// `onDelete: Restrict` a propósito: borrar a un profesor NO puede llevarse
  /// por delante las clases que otros reservaron. Un profesor que se va se
  /// suspende (`UserStatus.SUSPENDED`); sus aulas se cancelan una a una, que es
  /// lo que deja a los estudiantes enterados en vez de con una clase que
  /// desapareció sin explicación.
  teacherId String @map("teacher_id") @db.Uuid
  teacher   User   @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  title       String
  description String
  level       EnglishLevel

  /// Cupo máximo de estudiantes.
  maxStudents Int @map("max_students")

  /// Reservas CONFIRMED vigentes. Es el contador de la invariante de cupos
  /// (§4.2): **solo se muta dentro de la transacción que bloquea esta fila con
  /// `SELECT … FOR UPDATE`**, nunca en un `update` suelto.
  ///
  /// Existe desde el Sprint 2 aunque nadie lo mueva hasta el Sprint 3: añadirlo
  /// después sería otra migración, y la regla más crítica del sistema estaba ya
  /// especificada contra esta columna.
  ///
  /// La migración que sigue a esta añade a mano `CHECK (current_bookings >=
  /// 0)`: Prisma no modela `CHECK`, así que no aparece aquí, pero existe en la
  /// BD como red de seguridad — la garantía primaria sigue siendo la
  /// transacción de §4.2.
  currentBookings Int @default(0) @map("current_bookings")

  /// Inicio de la clase. `timestamptz` en UTC, sin excepciones (§4.7). Toda
  /// comparación temporal se hace en el servidor contra el reloj de la BD; el
  /// del cliente no decide nada.
  scheduledAt     DateTime @map("scheduled_at") @db.Timestamptz(3)
  durationMinutes Int      @map("duration_minutes")

  /// Enlace de la videollamada, **CIFRADO con AES-256-GCM** (§4.1). En esta
  /// columna nunca hay una URL legible: quien lea la base de datos por su
  /// cuenta —un backup, un SELECT de soporte, una fuga— no obtiene ninguna
  /// sala. El formato lo fija `MeetingLinkCipher`: `v1.<iv>.<tag>.<texto>`.
  ///
  /// Es texto y no `Bytes` para que siga siendo inspeccionable con las
  /// herramientas normales (Prisma Studio, psql) sin dejar de ser ilegible.
  meetingLink String @map("meeting_link")

  /// En Fase 1 siempre `MANUAL`. Ver el enum.
  meetingProvider MeetingProvider @default(MANUAL) @map("meeting_provider")

  /// Nace `PUBLISHED`: no hay flujo de borrador en Fase 1 (D15).
  status ClassroomStatus @default(PUBLISHED)

  /// Gancho para Fase 1.5. **En Fase 1 no hay NINGUNA lógica de recurrencia**:
  /// nadie construye series ni instancias a partir de esta columna.
  isRecurring Boolean @default(false) @map("is_recurring")

  /// En qué modos se imparte la clase (HU-211, `ARQUITECTURA.md` §4.9). Puede
  /// tener varios a la vez: una clase en señas con subtítulos en vivo declara
  /// los dos.
  ///
  /// **`@default([])` es DELIBERADO y no un placeholder.** Las aulas creadas
  /// antes de HU-211 se migran con el array vacío — «el profesor no lo ha
  /// indicado» — nunca con un modo inventado (decisión 5 de la HU): rellenarlo
  /// sería mentirle al estudiante sobre algo de lo que depende para seguir la
  /// clase. `POST /classrooms` exige que las aulas nuevas declaren al menos
  /// uno; esta columna no lo impone, esa regla vive en el DTO.
  communicationModes CommunicationPreference[] @default([]) @map("communication_modes")

  /// Los tres apoyos son campos aparte del modo: una clase en inglés hablado
  /// CON intérprete de señas no es lo mismo que una impartida directamente en
  /// señas (decisión 2 de HU-211).
  hasInterpreter     Boolean @default(false) @map("has_interpreter")
  hasLiveCaptions    Boolean @default(false) @map("has_live_captions")
  hasVisualMaterials Boolean @default(false) @map("has_visual_materials")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Reservas de estudiantes en esta aula. Ver la nota de borrado en `Booking`.
  bookings Booking[]

  /// Las aulas de un profesor, para «Mis aulas».
  @@index([teacherId])
  /// El listado público (HU-203): aulas publicadas ordenadas por horario. El
  /// orden de las columnas importa — `status` filtra por igualdad y
  /// `scheduledAt` por rango, así que la de igualdad va primero.
  @@index([status, scheduledAt])
  @@map("classrooms")
}

/// Reserva de un estudiante en un aula (HU-301). Es historial: nunca se borra,
/// solo cambia de `status` (`ARQUITECTURA.md` §4.3).
model Booking {
  id String @id @default(uuid()) @db.Uuid

  /// Quien reserva. `onDelete: Restrict` por la misma razón que `teacherId` en
  /// `Classroom`: no hay flujo de borrado de usuarios en Fase 1 (solo
  /// suspensión), y una reserva es historial que no puede desaparecer.
  studentId String @map("student_id") @db.Uuid
  student   User   @relation(fields: [studentId], references: [id], onDelete: Restrict)

  classroomId String    @map("classroom_id") @db.Uuid
  classroom   Classroom @relation(fields: [classroomId], references: [id], onDelete: Restrict)

  /// `CONFIRMED` al nacer. La transacción de §4.2 es el único escritor.
  status BookingStatus @default(CONFIRMED)

  /// Cuándo se canceló. `null` mientras esté vigente. Sin escritor hasta
  /// HU-303 — aquí solo nace la columna.
  cancelledAt DateTime? @map("cancelled_at")

  /// Marcas de envío de los recordatorios de 24h y 30min (§4.6). Solo
  /// columnas, sin lógica: el cron que las escribe y las usa para no duplicar
  /// envíos al reiniciar el proceso llega en el Sprint 4.
  reminder24hSentAt DateTime? @map("reminder_24h_sent_at")
  reminder30mSentAt DateTime? @map("reminder_30m_sent_at")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  /// Índice único PARCIAL, no total (`ARQUITECTURA.md` §4.3,
  /// `reglas-reservas.md` §3): un índice total impediría volver a reservar
  /// tras cancelar, porque la fila `CANCELLED` seguiría ocupándolo. Prisma no
  /// modela el `WHERE`, así que esta declaración es la aproximación más
  /// cercana; la migración que la acompaña añade la cláusula a mano — ver su
  /// comentario.
  @@unique([studentId, classroomId])
  @@index([studentId])
  @@index([classroomId])
  @@map("bookings")
}
