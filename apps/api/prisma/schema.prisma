// Schema de Prisma para @academia/api.
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // NOTA: la extensión de Prisma para VS Code puede subrayar `url`/`directUrl`
  // como "deprecados, muévelos a prisma.config.ts". Es un aviso de Prisma 7; la
  // extensión va por delante de nuestra CLI. Estamos PINEADOS a Prisma 6 (ver
  // README → Trampas conocidas), donde declararlos aquí es lo correcto y
  // soportado: `prisma validate/generate/migrate` pasan sin error. Ignorable
  // hasta que haya una HU específica para migrar a Prisma 7.

  // Runtime: en dev, Postgres en Docker; en staging/prod, pooler de Supabase.
  url = env("DATABASE_URL")

  // Migraciones: conexión directa. En Supabase, pgbouncer no soporta las
  // sentencias que Prisma Migrate necesita, por eso se separa de `url`.
  // En el Postgres de Docker (sin pooler) ambas apuntan al mismo sitio.
  directUrl = env("DIRECT_URL")
}

/// Roles de usuario de la plataforma.
///
/// Los valores DEBEN coincidir con el enum `UserRole` de @academia/types, que
/// es el contrato compartido con el frontend. Prisma genera su propio enum a
/// partir de este; ambos comparten los mismos miembros a propósito.
enum UserRole {
  STUDENT
  TEACHER
  ADMIN
}

/// Estado de la cuenta. Coincide con `UserStatus` de @academia/types.
enum UserStatus {
  ACTIVE
  PENDING
  SUSPENDED
}

/// Nivel de hipoacusia. Coincide con `HearingLossLevel` de @academia/types.
enum HearingLossLevel {
  NONE
  MILD
  MODERATE
  SEVERE
  PROFOUND
}

/// Preferencia de comunicación. Coincide con `CommunicationPreference`.
enum CommunicationPreference {
  SIGN_LANGUAGE
  LIP_READING
  WRITTEN_TEXT
  SPOKEN_AUDIO
}

/// Usuario de la plataforma. Modelo base de la HU-001, ampliado en la HU de
/// registro con estado de cuenta y preferencias de accesibilidad.
model User {
  id        String     @id @default(uuid()) @db.Uuid
  email     String     @unique
  /// Hash de la contraseña. NUNCA se expone en las respuestas de la API
  /// (ver el tipo `User` de @academia/types, que no incluye este campo).
  password  String
  firstName String     @map("first_name")
  lastName  String     @map("last_name")
  role      UserRole   @default(STUDENT)
  status    UserStatus @default(ACTIVE)

  /// Preferencias de accesibilidad. Opcionales: `null` si no se declararon.
  hearingLossLevel        HearingLossLevel?        @map("hearing_loss_level")
  communicationPreference CommunicationPreference? @map("communication_preference")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}
