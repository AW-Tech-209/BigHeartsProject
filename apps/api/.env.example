# Plantilla de variables de entorno de @academia/api.
# Copia este fichero a `.env` y rellena los valores:
#     cp apps/api/.env.example apps/api/.env
#
# El `.env` real está ignorado por git; este `.env.example` NO.

# Entorno de ejecución. Valores admitidos: development | staging | production
# Opcional (por defecto: development)
NODE_ENV=development

# Puerto HTTP en el que escucha la API.
# Opcional (por defecto: 3000)
PORT=3000

# OBLIGATORIA. Secreto para firmar los JWT. Mínimo 32 caracteres.
# En producción, genera uno con:  openssl rand -base64 48
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio-de-verdad

# ── Base de datos (PostgreSQL en Supabase) ───────────────────────────────────
# Sustituye [YOUR-PASSWORD] por la contraseña de la base de datos (Supabase →
# Project Settings → Database). NO la subas al repositorio: va solo en tu .env.
#
# OBLIGATORIA. Runtime: pooler en modo transacción (pgbouncer, puerto 6543).
DATABASE_URL=postgresql://postgres.trykybauinnrwhewslia:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:6543/postgres?pgbouncer=true
#
# OBLIGATORIA. Conexión directa en modo sesión (puerto 5432). La usa Prisma
# Migrate; pgbouncer no vale para migrar.
DIRECT_URL=postgresql://postgres.trykybauinnrwhewslia:[YOUR-PASSWORD]@aws-0-us-east-2.pooler.supabase.com:5432/postgres
