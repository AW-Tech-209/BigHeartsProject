# Imagen de DESARROLLO del backend (@academia/api) con hot-reload.
# No apta para producción: instala devDependencies y monta el código en runtime.
#
# El contexto de build es la RAÍZ del monorepo (ver docker-compose.yml), porque
# la API depende del workspace @academia/types y del package-lock.json de la raíz.

FROM node:22-alpine

WORKDIR /app

# Prisma necesita openssl para su motor de consultas en Alpine.
RUN apk add --no-cache openssl

# Husky instala hooks de git en el `prepare`; dentro de la imagen no hay repo,
# así que lo desactivamos para que `npm install` no falle.
ENV HUSKY=0

# 1) Manifiestos + schema de Prisma primero, para aprovechar la caché de capas:
#    mientras no cambien, no se reinstala en cada build.
COPY package.json package-lock.json ./
COPY packages/types/package.json ./packages/types/
COPY apps/api/package.json ./apps/api/
COPY apps/api/prisma ./apps/api/prisma/

# Instala todo el workspace. El postinstall de @academia/api corre
# `prisma generate`, que ya encuentra el schema copiado arriba.
RUN npm install

# 2) El resto del código que la imagen necesita en build.
COPY tsconfig.base.json ./
COPY packages ./packages
COPY apps/api/tsconfig.json apps/api/tsconfig.build.json apps/api/nest-cli.json ./apps/api/
COPY apps/api/src ./apps/api/src

# El paquete de tipos se consume compilado (dist); las apps lo importan así.
RUN npm run build:types

EXPOSE 3000

# Por defecto arranca en modo watch. docker-compose.yml sobrescribe el comando
# para además aplicar migraciones y sembrar datos antes de arrancar.
CMD ["npm", "run", "dev", "--workspace", "@academia/api"]
